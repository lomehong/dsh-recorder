{
  "name": "dsh-recorder",
  "version": "0.1.0",
  "description": "QS668/CB08 录音笔 BLE 控制 DSH 插件：扫描、连接、巡检、文件列表、下载、实时码流、录音控制、本地转写",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
